# Backend API Gateway
VITE_API_BASE_URL=http://localhost:8080

# Dev-only: omit paymentProvider to use BE's PAYMENT_PROVIDER=MOCK.
# Never enables a fake success response in the frontend.
VITE_PAYMENT_MOCK_ENABLED=false

# User Service OIDC issuer
VITE_OIDC_AUTHORITY=http://localhost:8082

# Public PKCE client registered by backend
VITE_OIDC_CLIENT_ID=cinema-web
