{
  "openapi": "3.0.1",
  "info": {
    "title": "Cinema Booking System API",
    "description": "API documentation for Cinema Booking System",
    "contact": { "name": "Cinema System" },
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:8081", "description": "Generated server url" }],
  "security": [{ "oauth2": [] }],
  "paths": {
    "/api/v1/movies/{id}": {
      "get": {
        "tags": ["movie-controller"],
        "operationId": "findById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MovieResponse" } } }
          }
        }
      },
      "put": {
        "tags": ["movie-controller"],
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateMovieRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MovieResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["movie-controller"],
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/movies/{id}/metadata": {
      "put": {
        "tags": ["movie-controller"],
        "summary": "Replace movie metadata",
        "description": "Requires movie:manage. Both properties must be present. Null clears a value. Artwork fallback is handled by the frontend.",
        "operationId": "updateMovieMetadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMovieMetadataRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated movie",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MovieResponse" } } }
          },
          "400": {
            "description": "Invalid request body or metadata",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          },
          "401": { "description": "Authentication required" },
          "403": { "description": "Required authority is missing" },
          "404": {
            "description": "Movie not found",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/api/v1/genres/{id}": {
      "get": {
        "tags": ["genre-controller"],
        "operationId": "findById_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/GenreResponse" } } }
          }
        }
      },
      "put": {
        "tags": ["genre-controller"],
        "operationId": "update_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateGenreRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/GenreResponse" } } }
          }
        }
      },
      "delete": {
        "tags": ["genre-controller"],
        "operationId": "delete_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/movies": {
      "get": {
        "tags": ["movie-controller"],
        "operationId": "findAll",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MovieResponse" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["movie-controller"],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateMovieRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MovieResponse" } } }
          }
        }
      }
    },
    "/api/v1/genres": {
      "get": {
        "tags": ["genre-controller"],
        "operationId": "findAll_1",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/GenreResponse" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["genre-controller"],
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateGenreRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/GenreResponse" } } }
          }
        }
      }
    },
    "/api/v1/movies/{movieId}/hero": {
      "patch": {
        "tags": ["movie-hero-controller"],
        "summary": "Update movie hero configuration",
        "description": "Requires movie:manage. Omitted properties are preserved. Null removes a time bound; enabled and priority cannot be null.",
        "operationId": "updateMovieHero",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMovieHeroRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Resulting hero configuration",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/MovieHeroConfigurationResponse" } }
            }
          },
          "400": {
            "description": "Invalid body or resulting configuration",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          },
          "404": {
            "description": "Movie not found",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          },
          "401": { "description": "Authentication required" },
          "403": { "description": "Missing movie:manage authority" }
        }
      }
    },
    "/api/v1/movies/hero": {
      "get": {
        "tags": ["movie-hero-controller"],
        "summary": "Get editorially selected movies for the hero",
        "description": "Returns eligible NOW_SHOWING movies in editorial order. Default limit is configured, initially 4; maximum initially 10. movieIds is an optional candidate filter applied before limiting. An empty supplied filter returns an empty list.",
        "operationId": "getHeroMovies",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Configured default when omitted; supported range 1–10.",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "movieIds",
            "in": "query",
            "description": "Optional UUID candidate list. Configured maximum initially 100. Use repeated movieIds query parameters.",
            "required": false,
            "schema": {
              "maxItems": 100,
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered movie list; may be empty",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MovieResponse" }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          },
          "404": {
            "description": "A selected movie disappeared during loading",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        },
        "security": []
      }
    },
    "/api/v1/movies/catalog": {
      "get": {
        "tags": ["movie-controller"],
        "summary": "Get a paginated movie catalog",
        "operationId": "getMovieCatalog",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["UPCOMING", "NOW_SHOWING", "ENDED", "INACTIVE"] }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "movieIds",
            "in": "query",
            "description": "Optional candidate movie UUIDs. Send repeated movieIds query parameters. Filtering is applied before pagination and counting. The configured input limit defaults to 100.",
            "required": false,
            "schema": { "type": "array", "items": { "type": "string", "format": "uuid" } }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Catalog order. Release-date sorts put null dates last. Title order uses the database collation. All orders use ascending movie ID as the final tie-breaker.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "RELEASE_DESC",
              "enum": ["RELEASE_DESC", "RELEASE_ASC", "TITLE_ASC"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A movie page, including empty pages",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/PageResponseMovieResponse" } }
            }
          },
          "400": {
            "description": "Invalid filter or pagination parameters",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          },
          "404": {
            "description": "A selected movie no longer exists",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateMovieRequest": {
        "required": ["durationMinutes", "genreIds", "status", "title"],
        "type": "object",
        "properties": {
          "title": { "maxLength": 255, "minLength": 0, "type": "string" },
          "description": { "maxLength": 5000, "minLength": 0, "type": "string" },
          "durationMinutes": { "minimum": 1, "type": "integer", "format": "int32" },
          "releaseDate": { "type": "string", "format": "date" },
          "posterUrl": { "maxLength": 500, "minLength": 0, "type": "string" },
          "trailerUrl": { "maxLength": 500, "minLength": 0, "type": "string" },
          "status": { "type": "string", "enum": ["UPCOMING", "NOW_SHOWING", "ENDED", "INACTIVE"] },
          "genreIds": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "GenreResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MovieResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "durationMinutes": { "type": "integer", "format": "int32" },
          "releaseDate": { "type": "string", "format": "date" },
          "posterUrl": { "type": "string" },
          "trailerUrl": { "type": "string" },
          "status": { "type": "string", "enum": ["UPCOMING", "NOW_SHOWING", "ENDED", "INACTIVE"] },
          "genres": {
            "uniqueItems": true,
            "type": "array",
            "items": { "$ref": "#/components/schemas/GenreResponse" }
          },
          "version": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "backdropUrl": {
            "type": "string",
            "description": "Landscape artwork URL. Null when unavailable.",
            "nullable": true
          },
          "ageRating": {
            "type": "string",
            "description": "Confirmed age classification. Null when unknown.",
            "nullable": true,
            "enum": ["P", "K", "T13", "T16", "T18"]
          }
        }
      },
      "UpdateMovieMetadataRequest": {
        "required": ["ageRating", "backdropUrl"],
        "type": "object",
        "properties": {
          "backdropUrl": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Absolute HTTP/HTTPS URL. Null clears the artwork.",
            "nullable": true
          },
          "ageRating": {
            "type": "string",
            "description": "Confirmed classification. Null clears the classification.",
            "nullable": true,
            "example": "T13",
            "enum": ["P", "K", "T13", "T16", "T18"]
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "timestamp": { "type": "string", "format": "date-time" },
          "data": { "type": "object" },
          "error": { "$ref": "#/components/schemas/ErrorBody" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "category": { "type": "string" },
          "details": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValidationError" }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
      },
      "UpdateGenreRequest": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": { "maxLength": 100, "minLength": 0, "type": "string" },
          "description": { "maxLength": 500, "minLength": 0, "type": "string" }
        }
      },
      "CreateMovieRequest": {
        "required": ["durationMinutes", "genreIds", "status", "title"],
        "type": "object",
        "properties": {
          "title": { "maxLength": 255, "minLength": 0, "type": "string" },
          "description": { "maxLength": 5000, "minLength": 0, "type": "string" },
          "durationMinutes": { "minimum": 1, "type": "integer", "format": "int32" },
          "releaseDate": { "type": "string", "format": "date" },
          "posterUrl": { "maxLength": 500, "minLength": 0, "type": "string" },
          "trailerUrl": { "maxLength": 500, "minLength": 0, "type": "string" },
          "status": { "type": "string", "enum": ["UPCOMING", "NOW_SHOWING", "ENDED", "INACTIVE"] },
          "genreIds": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "CreateGenreRequest": {
        "required": ["name"],
        "type": "object",
        "properties": {
          "name": { "maxLength": 100, "minLength": 0, "type": "string" },
          "description": { "maxLength": 500, "minLength": 0, "type": "string" }
        }
      },
      "UpdateMovieHeroRequest": {
        "type": "object",
        "properties": {
          "heroEnabled": {
            "type": "boolean",
            "description": "Omit to preserve the current value. Null is invalid."
          },
          "heroPriority": {
            "minimum": 0,
            "type": "integer",
            "description": "Lower values appear first. Omit to preserve. Null is invalid.",
            "format": "int32"
          },
          "heroStartsAt": {
            "type": "string",
            "description": "Offset timestamp. Omit to preserve; null removes the lower bound.",
            "format": "date-time",
            "nullable": true
          },
          "heroEndsAt": {
            "type": "string",
            "description": "Offset timestamp. Omit to preserve; null removes the upper bound.",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "MovieHeroConfigurationResponse": {
        "type": "object",
        "properties": {
          "movieId": { "type": "string", "format": "uuid" },
          "heroEnabled": { "type": "boolean" },
          "heroPriority": { "type": "integer", "format": "int32" },
          "heroStartsAt": { "type": "string", "format": "date-time", "nullable": true },
          "heroEndsAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "first": { "type": "boolean" },
          "last": { "type": "boolean" }
        }
      },
      "PageResponseMovieResponse": {
        "type": "object",
        "properties": {
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/MovieResponse" } },
          "page": { "$ref": "#/components/schemas/PageInfo" }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8082/oauth2/authorize",
            "tokenUrl": "http://localhost:8082/oauth2/token",
            "scopes": {
              "openid": "OpenID Connect",
              "profile": "Read profile",
              "email": "Read email",
              "booking:create": "Create bookings",
              "booking:read": "Read bookings",
              "booking:cancel": "Cancel bookings",
              "movie:manage": "Manage movies and genres",
              "showtime:manage": "Manage showtimes",
              "inventory:manage": "Manage cinema inventory",
              "payment:read": "Read payments",
              "user:manage": "Manage users"
            }
          }
        }
      }
    }
  }
}
